Cell[CellGroupData[{

Cell["\<\
6. Other tickers without the saved data (needs an internet connection)\
\>", "Section",ExpressionUUID->"792906a7-1943-7247-b2af-8374b290c764"],

Cell["\<\
collectRangePositions can also read tickers directly, without saving \
anything. With \"Loader\" -> Automatic and no local data layer it uses \
FinancialData (daily prices, merged into weeks that start on Monday, into \
months or into years), so it needs an internet connection and takes about 20 \
seconds for each ticker (the first call is slower). You can also give your \
own \"Loader\": a function of a ticker and a period (\"daily\", \"weekly\", \
\"monthly\" or \"yearly\") that gives a list of associations with the keys \
Date, Open, High, Low and Close; then \"Tickers\" is the list of names it \
understands. A few tickers give a few thousand candlesticks, so the histogram \
is far noisier than the one of 519 stocks: do not read spikes into it.\
\>", "Text",ExpressionUUID->"c38767c9-389f-0041-acc4-6b91e5f9447f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"YOUR", " ", "OWN", " ", 
     RowBox[{"TICKERS", ".", " ", "The"}], " ", "prices", " ", "come", " ", 
     "from", " ", "FinancialData", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"daily", " ", "prices"}], ",", " ", 
       RowBox[{
       "merged", " ", "into", " ", "weeks", " ", "that", " ", "start", " ", 
        "on", " ", "Monday"}]}], ")"}]}], ",", " ", 
    RowBox[{
     RowBox[{
     "so", " ", "this", " ", "needs", " ", "an", " ", "internet", " ", 
      "connection", " ", "and", " ", "takes", " ", "about", " ", "20", " ", 
      "seconds", " ", "for", " ", "each", " ", "ticker", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"the", " ", "first", " ", "call", " ", "is", " ", 
         RowBox[{"slower", ":", " ", 
          RowBox[{
          "FinancialData", " ", "prepares", " ", "its", " ", "indices"}]}]}], 
        ")"}], ".", " ", "\"\<CacheFile\>\""}]}], " ", "->", " ", 
     RowBox[{"None", ":", " ", 
      RowBox[{"nothing", " ", "is", " ", 
       RowBox[{"saved", ".", " ", "Replace"}], " ", "the", " ", "list", " ", 
       "with", " ", "your", " ", 
       RowBox[{"tickers", "."}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"myCollected", " ", "=", " ", 
    RowBox[{"collectRangePositions", "[", "\n", "  ", 
     RowBox[{"\"\<weekly\>\"", ",", "\n", "  ", 
      RowBox[{"\"\<Tickers\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<AAPL\>\"", ",", " ", "\"\<MSFT\>\"", ",", 
         " ", "\"\<XOM\>\"", ",", " ", "\"\<PEP\>\"", ",", " ", "\"\<PCG\>\"",
          ",", " ", "\"\<KO\>\"", ",", " ", "\"\<JNJ\>\"", ",", 
         " ", "\"\<IBM\>\""}], "}"}]}], ",", "\n", "  ", 
      RowBox[{"\"\<Loader\>\"", " ", "->", " ", "Automatic"}], ",", "\n", 
      "  ", 
      RowBox[{"\"\<CacheFile\>\"", " ", "->", " ", "None"}]}], "\n", "]"}]}], 
   ";"}]}]], "Input",ExpressionUUID->"edbdd9c9-20c0-d64b-931a-33d7d8931c7d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "The", " ", "candlesticks", " ", "that", " ", "were", " ", "read"}], ",", 
    " ", "kept", ",", " ", 
    RowBox[{
     RowBox[{"left", " ", "out", " ", "because", " ", "High"}], " ", "=", " ",
      "Low"}], ",", " ", 
    RowBox[{
    "and", " ", "left", " ", "out", " ", "because", " ", "the", " ", "Open", " ",
      "or", " ", "the", " ", "Close", " ", "is", " ", "outside", " ", "the", " ",
      "range", " ", "or", " ", "a", " ", "price", " ", "is", " ", 
     "missing"}]}], " ", "*)"}], "\n", 
  RowBox[{"myCollected", "[", "\"\<TickerSummary\>\"", "]"}]}]], "Input",Expre\
ssionUUID->"0385c291-a92a-fc4d-b92f-3a8f56296c32"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"The", " ", "same", " ", 
     RowBox[{"analysis", ".", " ", "A"}], " ", "few", " ", "tickers", " ", 
     "give", " ", "a", " ", "few", " ", "thousand", " ", "candlesticks"}], ",",
     " ", 
    RowBox[{
    "so", " ", "the", " ", "histogram", " ", "is", " ", "much", " ", 
     "noisier", " ", "than", " ", "the", " ", "one", " ", "of", " ", "519", " ", 
     RowBox[{"tickers", ":", " ", 
      RowBox[{
      "use", " ", "20", " ", "bins", " ", "and", " ", "expect", " ", "no", " ",
        "spikes", " ", "to", " ", "be", " ", 
       RowBox[{"reliable", "."}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"myResult", " ", "=", " ", 
    RowBox[{"rangePositionPreferences", "[", "\n", "  ", 
     RowBox[{"myCollected", ",", "\n", "  ", 
      RowBox[{"\"\<Bins\>\"", " ", "->", " ", "20"}], ",", "\n", "  ", 
      RowBox[{"\"\<FromYear\>\"", " ", "->", " ", "2001"}], ",", "\n", "  ", 
      RowBox[{"\"\<ToYear\>\"", " ", "->", " ", "Automatic"}], ",", "\n", 
      "  ", 
      RowBox[{"\"\<MinRelativeRange\>\"", " ", "->", " ", "0"}], ",", "\n", 
      "  ", 
      RowBox[{"\"\<SpikeThreshold\>\"", " ", "->", " ", "5"}], ",", "\n", 
      "  ", 
      RowBox[{"\"\<Null\>\"", " ", "->", " ", "True"}], ",", "\n", "  ", 
      RowBox[{"\"\<NullSteps\>\"", " ", "->", " ", "200"}], ",", "\n", "  ", 
      RowBox[{"\"\<NullPaths\>\"", " ", "->", " ", "100000"}], ",", "\n", 
      "  ", 
      RowBox[{"\"\<NullDrift\>\"", " ", "->", " ", "0"}], ",", "\n", "  ", 
      RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "\n", "]"}]}], 
   ";"}]}]], "Input",ExpressionUUID->"4473b10c-f3e4-8244-8540-d238821c7679"],

Cell[BoxData[
 RowBox[{"showRangePositionPreferences", "[", "\n", "  ", 
  RowBox[{"myResult", ",", "\n", "  ", 
   RowBox[{"\"\<Which\>\"", " ", "->", " ", "\"\<Both\>\""}], ",", "\n", "  ", 
   RowBox[{"\"\<ImageSize\>\"", " ", "->", " ", "520"}], ",", "\n", "  ", 
   RowBox[{"\"\<Theme\>\"", " ", "->", " ", "\"\<Light\>\""}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<ShowNull\>\"", " ", "->", " ", "True"}], ",", "\n", "  ", 
   RowBox[{"\"\<MarkSpikes\>\"", " ", "->", " ", "True"}], ",", "\n", "  ", 
   RowBox[{"\"\<YMax\>\"", " ", "->", " ", "Automatic"}]}], "\n", 
