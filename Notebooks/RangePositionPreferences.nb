Cell[CellGroupData[{

Cell["5. The price grid before 2001", "Section",ExpressionUUID->"0ead6822-c91f-194f-82fe-17d1c1bf79d5"],

Cell["\<\
The weekly candlesticks of 2000 and before: many bins stand out, at 1/4, 1/3, \
1/2, 2/3, 3/4, ... These are the places a candlestick of only a few ticks can \
have, not a preference of the market.\
\>", "Text",ExpressionUUID->"1c21ad39-44d3-e443-b68d-4b2e39488b31"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"THE", " ", "PRICE", " ", 
      RowBox[{"GRID", ".", " ", "The"}], " ", "weekly", " ", "candlesticks", " ",
       "of", " ", "2000", " ", "and", " ", "before", " ", 
      RowBox[{"(", 
       RowBox[{"prices", " ", "in", " ", "fractions"}], ")"}]}], ":", " ", 
     RowBox[{
     "the", " ", "preferred", " ", "percentages", " ", "are", " ", 
      "there"}]}], ",", " ", 
    RowBox[{"as", " ", "many", " ", "spikes", " ", "at", " ", 
     RowBox[{"1", "/", "4"}]}], ",", " ", 
    RowBox[{"1", "/", "3"}], ",", " ", 
    RowBox[{"1", "/", "2"}], ",", " ", 
    RowBox[{"2", "/", "3"}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"3", "/", "4"}], " ", "..."}], " ", "They", " ", "come", " ", 
     "from", " ", "ranges", " ", "of", " ", "only", " ", "a", " ", "few", " ",
      "ticks"}], ",", " ", 
    RowBox[{"not", " ", "from", " ", "the", " ", 
     RowBox[{"market", ".", " ", "Run"}], " ", "the", " ", "weekly", " ", 
     "block", " ", "above", " ", "first", " ", 
     RowBox[{
      RowBox[{"(", "weeklyCollected", ")"}], "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"weeklyOldResult", " ", "=", " ", 
    RowBox[{"rangePositionPreferences", "[", "\n", "  ", 
     RowBox[{"weeklyCollected", ",", "\n", "  ", 
      RowBox[{"\"\<Bins\>\"", " ", "->", " ", "100"}], ",", "\n", "  ", 
      RowBox[{"\"\<FromYear\>\"", " ", "->", " ", "1900"}], ",", "\n", "  ", 
      RowBox[{"\"\<ToYear\>\"", " ", "->", " ", "2000"}], ",", "\n", "  ", 
      RowBox[{"\"\<MinRelativeRange\>\"", " ", "->", " ", "0"}], ",", "\n", 
      "  ", 
      RowBox[{"\"\<SpikeThreshold\>\"", " ", "->", " ", "5"}], ",", "\n", 
      "  ", 
      RowBox[{"\"\<Null\>\"", " ", "->", " ", "False"}], ",", "\n", "  ", 
      RowBox[{"\"\<NullSteps\>\"", " ", "->", " ", "200"}], ",", "\n", "  ", 
      RowBox[{"\"\<NullPaths\>\"", " ", "->", " ", "100000"}], ",", "\n", 
      "  ", 
      RowBox[{"\"\<NullDrift\>\"", " ", "->", " ", "0"}], ",", "\n", "  ", 
      RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "\n", "]"}]}], 
   ";"}]}]], "Input",ExpressionUUID->"47b0d88a-3d49-3043-9fdb-adfc1ebe23dc"],

Cell[BoxData[
 RowBox[{"showRangePositionPreferences", "[", "\n", "  ", 
  RowBox[{"weeklyOldResult", ",", "\n", "  ", 
   RowBox[{"\"\<Which\>\"", " ", "->", " ", "\"\<Both\>\""}], ",", "\n", "  ", 
   RowBox[{"\"\<ImageSize\>\"", " ", "->", " ", "520"}], ",", "\n", "  ", 
   RowBox[{"\"\<Theme\>\"", " ", "->", " ", "\"\<Light\>\""}], ",", "\n", 
