       RowBox[{"about", " ", "760", " ", "000", " ", "of", " ", "them"}], 
       ")"}], " ", "leaves", " ", "a", " ", "few"}]}], ",", " ", 
    RowBox[{
    "mostly", " ", "at", " ", "simple", " ", "fractions", " ", "such", " ", 
     "as", " ", 
     RowBox[{"1", "/", "2."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"dailyResult", " ", "=", " ", 
    RowBox[{"rangePositionPreferences", "[", "\n", "  ", 
     RowBox[{"dailyCollected", ",", "\n", "  ", 
      RowBox[{"\"\<Bins\>\"", " ", "->", " ", "100"}], ",", "\n", "  ", 
      RowBox[{"\"\<FromYear\>\"", " ", "->", " ", "2001"}], ",", "\n", "  ", 
      RowBox[{"\"\<ToYear\>\"", " ", "->", " ", "Automatic"}], ",", "\n", 
      "  ", 
      RowBox[{"\"\<MinRelativeRange\>\"", " ", "->", " ", "0.03"}], ",", "\n",
       "  ", 
      RowBox[{"\"\<SpikeThreshold\>\"", " ", "->", " ", "5"}], ",", "\n", 
      "  ", 
      RowBox[{"\"\<Null\>\"", " ", "->", " ", "True"}], ",", "\n", "  ", 
      RowBox[{"\"\<NullSteps\>\"", " ", "->", " ", "200"}], ",", "\n", "  ", 
      RowBox[{"\"\<NullPaths\>\"", " ", "->", " ", "100000"}], ",", "\n", 
      "  ", 
      RowBox[{"\"\<NullDrift\>\"", " ", "->", " ", "0"}], ",", "\n", "  ", 
      RowBox[{"\"\<Seed\>\"", " ", "->", " ", "1"}]}], "\n", "]"}]}], 
   ";"}]}]], "Input",ExpressionUUID->"81bc225b-9680-7943-b059-384a9571417b"],

