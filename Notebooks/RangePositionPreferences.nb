       RowBox[{
        RowBox[{"the", " ", "constituents", " ", "of", " ", "the", " ", "S"}],
         "&"}], "P", " ", "500", " ", "in", " ", "November", " ", "2026"}], 
      ")"}]}], ",", " ", 
    RowBox[{"one", " ", "per", " ", 
     RowBox[{"line", ".", " ", "Replace"}], " ", "the", " ", "list", " ", 
     "to", " ", "use", " ", "other", " ", 
     RowBox[{"stocks", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"tickers", " ", "=", " ", 
     RowBox[{"Import", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", "\n", "    ", 
        RowBox[{"{", "\n", "      ", 
         RowBox[{
          RowBox[{"ParentDirectory", "[", 
           RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ",", "\n", 
          "      ", "\"\<Tickers.txt\>\""}], "\n", "    ", "}"}], "\n", "  ", 
        "]"}], ",", "\n", "  ", "\"\<List\>\""}], "\n", "]"}]}], ";"}], "\n", 
   
   RowBox[{"Length", "[", "tickers", "]"}]}]}]], "Input",ExpressionUUID->\
"fb974387-6f20-7242-9c8f-104ba17e28f9"],

